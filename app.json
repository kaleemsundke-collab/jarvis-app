{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis-app",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#02121c",
    "android": {
      "package": "com.kaleem.jarvis",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET",
        "CALL_PHONE",
        "ACCESS_FINE_LOCATION",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "READ_PHONE_STATE",
        "ANSWER_PHONE_CALLS",
        "SEND_SMS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "READ_CONTACTS",
        "READ_CALENDAR"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Jarvis listens for the wake word and your commands.",
          "speechRecognitionPermission": "Jarvis turns your speech into commands."
        }
      ]
    ],
    "owner": "kaleemsundkes-team",
    "extra": {
      "eas": {
        "projectId": "c5740f47-1541-4a75-8b3c-04d2a8f351d4"
      }
    }
  }
}