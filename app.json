{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis-app",
    "version": "1.9.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#02121c",
    "android": {
      "package": "com.kaleem.jarvis",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET",
        "CALL_PHONE",
        "ACCESS_FINE_LOCATION",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "READ_PHONE_STATE",
        "ANSWER_PHONE_CALLS",
        "SEND_SMS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "READ_CONTACTS",
        "READ_CALENDAR",
        "READ_CALL_LOG",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#03121c"
      }
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Jarvis listens for the wake word and your commands.",
          "speechRecognitionPermission": "Jarvis turns your speech into commands."
        }
      ]
    ],
    "owner": "kaleemsundkes-team",
    "extra": {
      "eas": {
        "projectId": "c5740f47-1541-4a75-8b3c-04d2a8f351d4"
      }
    },
    "icon": "./assets/icon.png"
  }
}